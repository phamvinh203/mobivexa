              "raw": "{\n  \"fullName\": \"Nguyen Van Test\",\n  \"phone\": \"0900000002\",\n  \"province\": \"TP. Hồ Chí Minh\",\n  \"district\": \"Quận 3\",\n  \"ward\": \"Phường 1\",\n  \"streetDetail\": \"456 Đường XYZ\"\n}"
