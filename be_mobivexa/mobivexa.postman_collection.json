            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van Test\",\n  \"phone\": \"0900000001\",\n  \"province\": \"TP. Hồ Chí Minh\",\n  \"district\": \"Quận 1\",\n  \"ward\": \"Phường Bến Nghé\",\n  \"streetDetail\": \"123 Đường ABC\",\n  \"isDefault\": true\n}"
            }
          }
