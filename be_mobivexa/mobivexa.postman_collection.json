{
  "info": {
    "name": "Mobivexa API",
    "description": "Bộ test toàn bộ API backend Mobivexa.\n\n## Cách dùng\n1. Import file này vào Postman.\n2. Chọn collection > tab Variables, sửa `baseUrl` nếu cần (mặc định http://localhost:5000).\n3. Chạy **Auth > Login (customer)** -> token tự lưu vào `accessToken`.\n4. Chạy **Auth > Login (admin)** -> token tự lưu vào `adminToken`.\n5. Các request khác tự gắn token từ biến. Các request cần id (slug/orderId/...) đọc từ biến collection — sửa cho khớp dữ liệu của bạn, hoặc nhiều response đã có script tự lưu id.\n\nRequest upload ảnh dùng form-data: chọn file thủ công ở tab Body trước khi gửi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "customerEmail", "value": "customer@test.com" },
    { "key": "customerPassword", "value": "Password123" },
    { "key": "adminEmail", "value": "admin@test.com" },
    { "key": "adminPassword", "value": "Password123" },
    { "key": "sepayWebhookSecret", "value": "your_webhook_secret_here" },
    { "key": "categorySlug", "value": "dien-thoai" },
    { "key": "categoryId", "value": "" },
    { "key": "brandSlug", "value": "apple" },
    { "key": "brandId", "value": "" },
    { "key": "productSlug", "value": "iphone-15" },
    { "key": "productId", "value": "" },
    { "key": "variantId", "value": "" },
    { "key": "imageId", "value": "" },
    { "key": "tagId", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "orderItemId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"fullName\": \"Nguyen Van Test\",\n  \"password\": \"{{customerPassword}}\",\n  \"phone\": \"0900000001\"\n}"
            }
          }
        },
        {
          "name": "Login (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "  console.log('Saved customer accessToken');",
                  "}",
                  "pm.test('status 200', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', json.accessToken);",
                  "  console.log('Saved adminToken');",
                  "}",
                  "pm.test('status 200', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\"\n}" }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword123\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
    },
