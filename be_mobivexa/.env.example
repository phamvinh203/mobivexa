# ═══════════════════════════════════════════════════════════════════════════
# MOBIVEXA BACKEND — file mẫu biến môi trường
# Cách dùng: copy file này thành `.env.local` rồi điền giá trị thật.
#   cp .env.example .env.local
# `.env.local` đã bị .gitignore — KHÔNG bao giờ commit giá trị thật lên git.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Kết nối chính (có thể qua pgbouncer/pooler).
DATABASE_URL=postgresql://postgres:password@localhost:5432/mobivexa?schema=public
# Kết nối trực tiếp — dùng cho prisma db push / db pull khi chạy qua pooler.
DIRECT_URL=postgresql://postgres:password@localhost:5432/mobivexa?schema=public
# Bật khi DB dev dùng SSL tự ký (Supabase/Neon local...) mà certificate bị chối.
DB_SSL_NO_VERIFY=false

# ─── Redis (tùy chọn) ────────────────────────────────────────────────────────
# Store cho rate-limit phân tán. Bỏ trống nếu chạy local không cần Redis.
REDIS_URL=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# BẮT BUỘC tối thiểu 32 ký tự — server fail-fast nếu ngắn hơn (HS256).
JWT_ACCESS_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu!!
JWT_REFRESH_SECRET=thay-bang-chuoi-ngau-nhien-khac-32-ky-tu!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS (FE) ───────────────────────────────────────────────────────────────
# CLIENT_URL: origin chính của web khách; FRONTEND_URL: danh sách origin cho phép
# (phân tách bằng dấu phẩy) — web khách 5001, admin 5002.
CLIENT_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5001,http://localhost:5002

# ─── Google OAuth (đăng nhập bằng Google) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Cloudinary (upload ảnh) ─────────────────────────────────────────────────
# Định dạng: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name

# ─── SMTP (gửi email quên mật khẩu) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mobivexa <no-reply@mobivexa.local>

# ─── SePay (thanh toán chuyển khoản + webhook) ──────────────────────────────
# Thông tin tài khoản ngân hàng hiển thị trên VietQR.
SEPAY_BANK_ID=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Secret để verify webhook — phải khớp với secret khai báo bên SePay.
SEPAY_WEBHOOK_SECRET=thay-bang-webhook-secret
# Token SePay UserAPI — dùng cho POST /api/admin/payment/sync (kéo lại giao dịch
# khi nghi webhook bị rớt). Để trống nếu không dùng tính năng sync.
SEPAY_API_TOKEN=

# ─── Chatbot AI (Gemini) ─────────────────────────────────────────────────────
# false = ẩn toàn bộ chatbot (POST /api/chat trả 503) — không cần key vẫn chạy app.
CHATBOT_ENABLED=true
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model chính + chuỗi fallback (chỉ rơi model kế khi 429/503). ĐỪNG dùng cứng
# gemini-2.5-flash (404 với user mới từ 09/2026) — kiểm tra model còn sống trước.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite
